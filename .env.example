# GigaChat: Client ID и Secret из проекта в Сбере
GIGACHAT_CLIENT_ID=
GIGACHAT_SECRET=
# Или один ключ авторизации (если нет ID/Secret)
GIGACHAT_AUTH_KEY=

# Токен бота из MAX
MAX_API_KEY=

# Адрес вебхука. Оставь пустым для long polling
WEBHOOK_URL=

# Модель и права доступа GigaChat
GIGACHAT_MODEL=GigaChat-3-Ultra
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_VERIFY_SSL=false

# Настройки API MAX
MAX_API_URL=https://platform-api2.max.ru
MAX_VERIFY_SSL=true
MAX_WEBHOOK_SECRET=

# База данных PostgreSQL. Пароль должен совпадать с POSTGRES_PASSWORD
DATABASE_URL=postgresql+asyncpg://socrat:СЮДА_ПАРОЛЬ@db:5432/socrat
POSTGRES_USER=socrat
POSTGRES_PASSWORD=СЮДА_ТОТ_ЖЕ_ПАРОЛЬ
POSTGRES_DB=socrat

# Распознавание фото через GigaChat
VISION_ENABLED=true
GIGACHAT_VISION_VERIFY=always
GIGACHAT_VISION_MODEL=

# Режим общения: off (строгий) или friendly
CHAT_MODE=off
ACTIVE_SUBJECT=informatics

# Таймауты и лимиты
SESSION_IDLE_HOURS=4
HISTORY_RETENTION_DAYS=30
RATE_PER_MINUTE=8
RATE_PER_DAY=200
THINKING_MESSAGE_AFTER=20
PROCESS_TIMEOUT=300
LLM_CHECKER=false